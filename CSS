.container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 700px;
}

.item1 {
  width: 500px;
  height: 700px;
  background-color: lightblue;
}

.item2 {
  width: 500px;
  height: 700px;
  background-color: lightgreen;
}

.item3 {
  width: 500px;
  height: 700px;
  background-color: lightpink;
}

.container2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 1300px;
}
.item4 {
  width: 500px;
  height: 700px;
  background-color: lightcoral;
}
.item5 {
  width: 500px;
  height: 700px;
  background-color: lightgoldenrodyellow;
}
.item6 {
  width: 500px;
